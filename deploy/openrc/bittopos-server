#!/sbin/openrc-run
description="Bittopos HTTP Server"
command="/opt/bittopos/bin/bittopos-server"
command_user="bittopos:bittopos"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
directory="/var/lib/bittopos"
output_log="/var/log/bittopos-server.log"
error_log="/var/log/bittopos-server.err"
supervisor=supervise-daemon

depend() {
  need net
  after firewall
}

start_pre() {
  [ -r /etc/bittopos/bittopos.env ] || return 1
  export $(grep -v '^[[:space:]]*#' /etc/bittopos/bittopos.env | xargs -0 2>/dev/null)
}
